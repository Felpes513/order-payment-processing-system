# Credenciais locais: nao versionar este arquivo.
# Use valores sem aspas, espacos, $, # ou barra invertida para compatibilidade
# entre Docker Compose e Spring properties. Prefira senhas longas alfanumericas.

# PostgreSQL - pedidos
ORDER_DATABASE_URL=jdbc:postgresql://localhost:5433/order_db
ORDER_DATABASE_USERNAME=order_user
ORDER_DATABASE_PASSWORD=

# PostgreSQL - estoque
INVENTORY_DATABASE_URL=jdbc:postgresql://localhost:5434/inventory_db
INVENTORY_DATABASE_USERNAME=inventory_user
INVENTORY_DATABASE_PASSWORD=

# RabbitMQ - compartilhado pelos servicos
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=rabbitmq_user
RABBITMQ_PASSWORD=
